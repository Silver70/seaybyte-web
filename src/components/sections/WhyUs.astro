---
// Stroke icons on a 24×24 grid
const icons = {
	shield: 'M12 3 5 6v5c0 4.5 3 8.3 7 9.5 4-1.2 7-5 7-9.5V6l-7-3ZM9 12l2 2 4-4',
	refresh: 'M21 12a9 9 0 1 1-2.64-6.36M21 3v6h-6',
	sliders: 'M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6',
};

const steps = ['Plan', 'Design', 'Build', 'Support'];

const reasons = [
	{
		icon: icons.shield,
		title: 'Built to last',
		text: 'Modern, well-documented technology that’s fast, secure and easy to hand over. Everything we build is yours.',
	},
	{
		icon: icons.refresh,
		title: 'We stay after launch',
		text: 'Launch day isn’t the finish line. We stick around for updates, fixes and advice as your business grows.',
	},
	{
		icon: icons.sliders,
		title: 'Right-sized for you',
		text: 'From a one-page site to a full office network, the solution is scaled to your goals and your budget.',
	},
];
---

<section
	id="why-us"
	class="relative z-10 bg-section py-24 sm:py-32"
	aria-labelledby="why-us-heading"
>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid gap-6 lg:grid-cols-2 lg:items-end lg:gap-16">
			<h2 id="why-us-heading" class="text-3xl leading-tight font-bold tracking-tight text-ink sm:text-4xl lg:text-5xl">
				Why businesses choose us
			</h2>
			<p class="max-w-lg text-base leading-relaxed text-muted sm:text-lg lg:justify-self-end">
				We’re a small, focused team that treats your technology like it’s our own — practical, honest and in it for
				the long run.
			</p>
		</div>

		<div class="mt-12 grid gap-4 sm:mt-16 lg:grid-cols-3 lg:gap-5">
			<!-- Featured: the full-service pitch, with the process strip as its visual -->
			<article class="rounded-3xl border border-brand-navy/8 bg-white p-8 sm:p-10 lg:col-span-2">
				<h3 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Everything under one roof</h3>
				<p class="mt-3 max-w-xl leading-relaxed text-muted">
					Websites, apps, design, IT support and networks — handled by one team that knows your whole setup, so nothing
					gets lost between vendors.
				</p>

				<div class="relative mt-10">
					<!-- Connecting line behind the step markers -->
					<div class="absolute top-5 right-[12.5%] left-[12.5%] hidden h-px bg-brand-navy/15 sm:block" aria-hidden="true"></div>
					<ol class="relative grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-0">
						{
							steps.map((step, i) => (
								<li class="flex items-center gap-3 rounded-2xl bg-brand-navy/3 p-3 sm:flex-col sm:bg-transparent sm:p-0">
									<span class="grid size-10 shrink-0 place-items-center rounded-full border border-brand-cyan-dark/40 bg-white font-mono text-xs font-medium text-brand-cyan-dark">
										{String(i + 1).padStart(2, '0')}
									</span>
									<span class="text-sm font-semibold text-ink">{step}</span>
								</li>
							))
						}
					</ol>
				</div>
			</article>

			<!-- Dark accent card -->
			<article class="rounded-3xl bg-brand-navy-dark p-8 text-white sm:p-10">
				<h3 class="text-2xl font-semibold tracking-tight sm:text-3xl">Straight answers, no jargon</h3>
				<p class="mt-3 leading-relaxed text-white/70">
					We’ll tell you what you actually need — and what you don’t. Clear quotes up front and no surprise invoices.
				</p>
				<p class="mt-8 border-t border-white/15 pt-6 text-lg font-medium text-brand-cyan">
					Plain English, honest advice.
				</p>
			</article>

			<!-- The remaining reasons share one panel, split by hairlines, rather than three identical cards -->
			<ul class="grid rounded-3xl border border-brand-navy/8 bg-white lg:col-span-3 lg:grid-cols-3">
				{
					reasons.map((reason) => (
						<li class="border-brand-navy/8 p-8 not-last:border-b lg:not-last:border-r lg:not-last:border-b-0">
							<h3 class="flex items-center gap-3 text-xl font-semibold tracking-tight text-ink">
								<svg class="size-5 shrink-0 text-brand-cyan-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d={reason.icon} />
								</svg>
								{reason.title}
							</h3>
							<p class="mt-3 leading-relaxed text-muted">{reason.text}</p>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
